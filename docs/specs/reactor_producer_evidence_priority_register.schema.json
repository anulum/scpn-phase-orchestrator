              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "schema": {
                  "type": "string",
                  "minLength": 1
                },
                "schema_version": {
                  "const": "1.0.0"
                },
                "payload_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "file_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "diagnostic_plan_portfolio_status": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "schema",
                "schema_version",
                "payload_sha256",
                "file_sha256"
