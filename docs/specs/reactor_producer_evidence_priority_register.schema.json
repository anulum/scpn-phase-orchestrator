            {
              "const": "reference"
            },
            {
              "const": "clock_epoch"
            },
            {
              "const": "observation_operator_or_calibration"
            },
            {
              "const": "uncertainty"
            },
            {
              "const": "validity"
            },
            {
              "const": "quality"
            },
            {
              "const": "provenance"
            },
            {
              "const": "observability_gate"
            }
          ],
          "items": false,
          "minItems": 10,
          "maxItems": 10
        },
        "project_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "diagnostic_plan_portfolio_projects",
            "registry_device_owner_projects",
            "upstream_reactor_projects",
            "control_project",
            "orchestration_authority_project"
