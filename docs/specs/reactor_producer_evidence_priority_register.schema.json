              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "schema": {
                  "type": "string",
                  "minLength": 1
                },
                "schema_version": {
                  "const": "1.2.0"
                },
                "payload_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "file_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "signal_occurrence_ledger": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "schema",
                "schema_version",
                "payload_sha256",
                "file_sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "schema": {
                  "type": "string",
                  "minLength": 1
                },
                "schema_version": {
                  "const": "1.0.0"
                },
                "payload_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "file_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            },
            "technology_diagnostic_atlas": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "schema",
                "schema_version",
                "payload_sha256",
                "file_sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "schema": {
                  "type": "string",
                  "minLength": 1
                },
                "schema_version": {
                  "const": "1.0.0"
                },
                "payload_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "file_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
