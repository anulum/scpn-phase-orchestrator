        "priority_score": {
          "const": null
        },
        "authority": {
          "const": "review_only"
        },
        "actionable": {
          "const": false
        },
        "direct_actuation_authorized": {
          "const": false
        },
        "machine_protection_final_veto": {
          "const": true
