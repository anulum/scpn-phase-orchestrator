{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anulum.li/schemas/scpn-phase-orchestrator/reactor-producer-evidence-priority-register.v1.schema.json",
  "title": "SCPN Phase Orchestrator reactor producer evidence priority register v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
