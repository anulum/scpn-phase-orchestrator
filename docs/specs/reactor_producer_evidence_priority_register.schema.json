              "pattern": "^SCPN-[A-Z0-9-]+$"
            },
            "artifact_kind": {
              "const": "configuration_specific_canonical_evidence_envelope"
            },
            "required_evidence": {
              "type": "array",
              "prefixItems": [
                {
                  "const": "physical_sample"
                },
                {
                  "const": "phenomenon_identity"
                },
                {
                  "const": "reference"
                },
                {
                  "const": "clock_epoch"
                },
                {
                  "const": "observation_operator_or_calibration"
                },
                {
                  "const": "uncertainty"
                },
                {
                  "const": "validity"
                },
                {
                  "const": "quality"
                },
                {
                  "const": "provenance"
                },
                {
                  "const": "observability_gate"
                }
              ],
              "items": false,
              "minItems": 10,
              "maxItems": 10
            },
            "lane_blockers": {
              "$ref": "#/$defs/stringArray"
            },
