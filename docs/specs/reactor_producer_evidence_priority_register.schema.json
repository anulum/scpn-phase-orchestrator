          "type": "object",
          "additionalProperties": false,
          "required": [
            "built_in_configurations",
            "built_in_confinement_families",
            "registry_device_owner_projects",
            "upstream_reactor_projects",
            "diagnostic_plan_portfolio_projects",
            "control_projects",
            "upstream_plus_control_projects",
            "L0_qualify_existing_physical_source",
            "L1_extend_exercised_review_adapter",
            "L2_build_from_accepted_plan",
            "L3_repair_refused_plan_before_intake",
            "qualified_physical_observations",
            "qualified_physical_phases",
            "control_admitted"
          ],
          "properties": {
            "built_in_configurations": {
              "const": 32
            },
            "built_in_confinement_families": {
              "const": 8
            },
            "registry_device_owner_projects": {
              "const": 21
            },
            "upstream_reactor_projects": {
              "const": 22
            },
            "diagnostic_plan_portfolio_projects": {
              "const": 20
            },
            "control_projects": {
              "const": 1
            },
            "upstream_plus_control_projects": {
              "const": 23
            },
            "L0_qualify_existing_physical_source": {
              "const": 1
            },
            "L1_extend_exercised_review_adapter": {
              "const": 2
            },
            "L2_build_from_accepted_plan": {
              "const": 29
            },
            "L3_repair_refused_plan_before_intake": {
              "const": 0
            },
            "qualified_physical_observations": {
              "const": 0
            },
            "qualified_physical_phases": {
              "const": 0
            },
            "control_admitted": {
              "const": 0
            }
          }
        },
        "configurations": {
          "type": "array",
          "minItems": 32,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/configuration"
          }
        },
        "authority": {
          "const": "review_only"
        },
        "actionable": {
          "const": false
        },
        "direct_actuation_authorized": {
          "const": false
        },
        "machine_protection_final_veto": {
          "const": true
        }
      }
    }
  },
  "$defs": {
    "upstreamProjectId": {
      "enum": [
        "SCPN-BEAM-TARGET-CORE",
        "SCPN-DENSE-PLASMA-FOCUS-CORE",
        "SCPN-FRC-CORE",
        "SCPN-FUSION-CORE",
        "SCPN-FUSION-FISSION-HYBRID-CORE",
        "SCPN-ICF-BEAM-CORE",
        "SCPN-ICF-IMPACT-CORE",
        "SCPN-ICF-LASER-CORE",
        "SCPN-IEC-CORE",
        "SCPN-LEVITATED-DIPOLE-CORE",
        "SCPN-MAGNETIC-CUSP-CORE",
        "SCPN-MIF-CORE",
        "SCPN-MIF-LINER-CORE",
        "SCPN-MIF-MAGLIF-CORE",
        "SCPN-MIF-PLASMA-JET-CORE",
        "SCPN-MIRROR-CORE",
        "SCPN-RFP-CORE",
        "SCPN-SPHEROMAK-CORE",
        "SCPN-STELLARATOR-CORE",
        "SCPN-THETA-PINCH-CORE",
        "SCPN-TOKAMAK-CORE",
        "SCPN-Z-PINCH-CORE"
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "diagnosticPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural_status",
        "custody_state",
        "observed_revision",
        "fixture_sha256",
        "missing_required_members",
        "affected_channel_ids"
      ],
      "properties": {
        "structural_status": {
          "enum": [
            "accepted",
            "refused",
            "not_in_portfolio"
          ]
        },
        "custody_state": {
          "enum": [
            "exact_fixture_custody",
            "verified_public_producer_object",
            "producer_fix_required",
            "not_in_portfolio"
          ]
        },
        "observed_revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixture_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing_required_members": {
          "$ref": "#/$defs/stringArray"
        },
        "affected_channel_ids": {
          "$ref": "#/$defs/stringArray"
        }
      }
