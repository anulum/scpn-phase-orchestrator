            "physical_source_present": {
              "type": "boolean"
            },
            "portable_review_adapter_present": {
              "type": "boolean"
            },
            "qualified_observation": {
              "const": false
            },
            "qualified_physical_phase": {
              "const": false
            }
          }
        },
        "diagnostic_plan": {
          "$ref": "#/$defs/diagnosticPlan"
        },
        "readiness_axes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exact_configuration_identity",
            "external_context_present",
            "physical_source_present",
            "portable_review_adapter_present",
            "structural_plan_accepted",
            "exact_plan_fixture_custody",
            "complete_physical_evidence",
            "control_admission"
