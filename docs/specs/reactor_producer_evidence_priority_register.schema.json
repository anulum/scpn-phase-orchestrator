              "uniqueItems": true,
              "minItems": 20,
              "maxItems": 20
            },
            "registry_device_owner_projects": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/upstreamProjectId"
              },
              "uniqueItems": true,
              "minItems": 21,
              "maxItems": 21
            },
            "upstream_reactor_projects": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/upstreamProjectId"
