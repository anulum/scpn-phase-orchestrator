  "reproduction_script": "import sys,json,time,statistics\nsys.path.insert(0,'src')\nimport numpy as np\nfrom scpn_phase_orchestrator.coupling import te_adaptive as a\nfrom scpn_phase_orchestrator.monitor import transfer_entropy as te\nte.ACTIVE_BACKEND='python'\nrecords=[]\nfor n in (4,8):\n rng=np.random.default_rng(2026);k=np.ones((n,n))*.5;np.fill_diagonal(k,0.)\n h=rng.uniform(0.,2*np.pi,(n,128));times=[]\n for _ in range(5):\n  start=time.perf_counter();result=a.te_adapt_coupling(k,h,lr=.02,decay=.1,n_bins=8);times.append((time.perf_counter()-start)*1000)\n records.append({'n':n,'samples':128,'public_pipeline_median_ms':statistics.median(times),'result':result.tolist()})\nprint(json.dumps({'python':sys.version.split()[0],'numpy':np.__version__,'adaptation_rust':a._HAS_RUST,'te_backend':te.ACTIVE_BACKEND,'records':records}))\n"
